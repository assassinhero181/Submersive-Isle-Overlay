{
  "name": "submersiveisleoverlay",
  "version": "1.1.6",
  "description": "Submersive Isle Overlay v 1.0.0 \u2014 The Isle Evrima desktop launcher and live overlay",
  "main": "overlay.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "dist": "electron-builder --win nsis portable"
  },
  "keywords": [],
  "author": "SubmersiveRP",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.submersiveisle.overlay",
    "productName": "Submersive Isle Overlay",
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!rcon-config.json",
      "!rcon-config.local.json",
      "!rcon client.json",
      "!rcon-client.js"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "Submersive-Isle-Overlay-v${version}-Portable.exe"
    },
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Submersive-Isle-Overlay-v${version}-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "assassinhero181",
      "repo": "Submersive-Isle-Overlay",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Submersive Isle Steam Login",
        "schemes": [
          "submersive-isle"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "productName": "Submersive Isle Overlay"
}
